"shortcutsWhenActive.openSettingsFromSwitcherSubtitle" = "Only when the switcher stays open after you release the shortcut (Keep open, or window hints). Default matches the app menu: ⌘,.";
"shortcutsWhenActive.tableSubtitle" = "Normal navigation: after Escape leaves window-hint mode (or if window hints are off), these shortcuts run as usual. Window-hint mode: single-letter shortcuts on thumbnails take priority; Escape exits hint mode. Shortcuts for minimize, close, quit, fullscreen, and hide hint modes are in “Additional controls…” (Hint mode navigation). “Close the switcher immediately” only applies while window-hint mode is on when “Show window hints on thumbnails” is enabled; otherwise it applies whenever the switcher is open. If it and “Quit app” share the same key (e.g. plain Q), that key closes the switcher in hint mode and quits the app in normal navigation.";
"shortcutsWhenActive.dismissSwitcherSubtitle" = "Only while window-hint mode is on (with “Show window hints on thumbnails” enabled). Closes the switcher; the same key is not used as a window hint. With window hints off in preferences, this shortcut works whenever the switcher is open.";
"shortcutsWhenActive.dismissSwitcherSectionTitle" = "Dismiss switcher (scoped)";
"shortcutsWhenActive.dismissSwitcherSectionSubtitle" = "Separate from the shortcuts above: different scope than Quit app; the same key can be used for both.";
"shortcutsWhenActive.quitAppSubtitle" = "In normal navigation (after Escape leaves window-hint mode), this quits the front app. If it uses the same key as “Close the switcher” without modifiers, that key quits here and closes the switcher only in hint mode.";
"additionalControls.hintModeNavigationTitle" = "Hint mode navigation";
"additionalControls.hintModeNavigationSubtitle" = "When window hints are on, these shortcuts switch between hint modes (minimize, close, quit, fullscreen, hide). In each mode, type the single-letter hint on a thumbnail to act on that window. When window hints are off, each shortcut performs its action on the selected window. Defaults: ⌃M minimize, ⌃C close, ⌃W quit, ⌃F fullscreen, ⌃H hide.";
"vimKeys.enableSubtitle" = "When on, the Vim navigation shortcuts in “Shortcuts when active…” move the selection. They are independent of arrow keys and other actions.";
"vimNavigation.subtitle" = "These four shortcuts work only while the switcher is open and “Select windows using vim keys” is enabled. They are separate from arrow keys and other shortcuts.";
